Group: build-fix
Reason: Boost 1.89 and later have no compiled Boost.System library; accept the header-only Boost.System that the AX_BOOST_SYSTEM header check already found.

diff --git a/m4/ax_boost_system.m4 b/m4/ax_boost_system.m4
index 323e2a6..a6335d9 100644
--- a/m4/ax_boost_system.m4
+++ b/m4/ax_boost_system.m4
@@ -108,7 +108,11 @@ AC_DEFUN([AX_BOOST_SYSTEM],
 
             fi
             if test "x$ax_lib" = "x"; then
-                AC_MSG_ERROR(Could not find a version of the Boost::System library!)
+                # Boost.System is header-only in Boost 1.69 and later, and Boost 1.89
+                # no longer ships the compiled library. The header check above passed.
+                BOOST_SYSTEM_LIB=""
+                AC_SUBST(BOOST_SYSTEM_LIB)
+                link_system="yes"
             fi
 			if test "x$link_system" = "xno"; then
 				AC_MSG_ERROR(Could not link against $ax_lib !)
