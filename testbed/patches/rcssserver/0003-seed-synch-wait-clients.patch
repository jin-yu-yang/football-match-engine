 bool
+Stadium::doHoldForClients()
+{
+    // synch_wait_clients: before kick-off, only receive client messages
+    // until the given number of players and online coaches is connected.
+    const int wait_clients = ServerParam::instance().synchWaitClients();
+    if ( wait_clients <= 0
+         || M_clients_waited
+         || time() != 0
+         || playmode() != PM_BeforeKickOff )
+    {
+        return false;
+    }
+
+    doRecvFromClients();
+
+    int count = static_cast< int >( M_remote_players.size() );
+    for ( OnlineCoachCont::const_reference olc : M_remote_online_coaches )
+    {
+        if ( olc->assigned() )
+        {
+            ++count;
+        }
+    }
+
+    if ( count >= wait_clients )
+    {
+        M_clients_waited = true;
+        return false;
+    }
+
+    std::chrono::microseconds sleep_count( 1000 );
+    std::this_thread::sleep_for( sleep_count );
+    return true;
+}
